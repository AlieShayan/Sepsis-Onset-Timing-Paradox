\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Operational Clocks, Pre-Suspicion Decision Windows, and Population Opportunity Attrition.} Panel A illustrates the clinical timeline for an ICU-incident sepsis patient, depicting the search-window lead $G_i = 24h + h\,\operatorname  {frac}(x_i) < 25h$ for first-bin-assigned episodes ($N=274/408$, 67.2\%; median $+24.2\text  {h}$; empirical max $24.99\text  {h}$), the pre-suspicion decision set $\mathcal  {A}_i(\delta ) = \{t \in \mathcal  {T}_i : 0 < T_{\text  {S3},i}-t \le 6\text  {h}, t+\delta \le T_{\mathrm  {susp},i}\}$, and the post-anchor censored period. Panel B displays population opportunity attrition comparing Broad Historical MIMIC-III (earliest prescription proxy $T_{\mathrm  {Rx,start}}$) and MIMIC-III MetaVision (primary benchmark $T_{\mathrm  {susp}}$), highlighting eligibility under declared midnight assignment. \textit  {Alt-text:} Two-panel diagram displaying timeline clocks and mathematical risk-set definitions in Panel A, and horizontal bar charts comparing surveillance coverage and treatment-precedence opportunity in Panel B.}}{7}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:clocks}{{1}{7}{\textbf {Operational Clocks, Pre-Suspicion Decision Windows, and Population Opportunity Attrition.} Panel A illustrates the clinical timeline for an ICU-incident sepsis patient, depicting the search-window lead $G_i = 24h + h\,\operatorname {frac}(x_i) < 25h$ for first-bin-assigned episodes ($N=274/408$, 67.2\%; median $+24.2\text {h}$; empirical max $24.99\text {h}$), the pre-suspicion decision set $\mathcal {A}_i(\delta ) = \{t \in \mathcal {T}_i : 0 < T_{\text {S3},i}-t \le 6\text {h}, t+\delta \le T_{\mathrm {susp},i}\}$, and the post-anchor censored period. Panel B displays population opportunity attrition comparing Broad Historical MIMIC-III (earliest prescription proxy $T_{\mathrm {Rx,start}}$) and MIMIC-III MetaVision (primary benchmark $T_{\mathrm {susp}}$), highlighting eligibility under declared midnight assignment. \textit {Alt-text:} Two-panel diagram displaying timeline clocks and mathematical risk-set definitions in Panel A, and horizontal bar charts comparing surveillance coverage and treatment-precedence opportunity in Panel B}{figure.caption.1}{}}
