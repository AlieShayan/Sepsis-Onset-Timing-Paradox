\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Benchmark Discrimination Across Outcome-Stratified Hybrid Risk Sets (Held-Out Point Estimates and Clustered 95\% CIs).} Point estimates calculated directly on held-out test data ($B=0$); 95\% CIs derived from $B=1,000$ patient-clustered bootstrap resamples. Evaluated on hybrid risk sets $\mathcal  {R}_0^{\mathrm  {hybrid}}$ and $\mathcal  {R}_2^{\mathrm  {hybrid}}$ censoring cases at infection-suspicion anchor $T_{\mathrm  {susp}}$ and controls at earliest prescription $T_{\mathrm  {Rx,start}}$. Sepsis cases and controls were restricted using different clinical-process anchors; differences from canonical discrimination reflect both evaluated observations and outcome-specific selection, and do not represent a uniform prospective eligibility policy.}}{5}{table.caption.3}\protected@file@percent }
\newlabel{tab:table2}{{2}{5}{\textbf {Benchmark Discrimination Across Outcome-Stratified Hybrid Risk Sets (Held-Out Point Estimates and Clustered 95\% CIs).} Point estimates calculated directly on held-out test data ($B=0$); 95\% CIs derived from $B=1,000$ patient-clustered bootstrap resamples. Evaluated on hybrid risk sets $\mathcal {R}_0^{\mathrm {hybrid}}$ and $\mathcal {R}_2^{\mathrm {hybrid}}$ censoring cases at infection-suspicion anchor $T_{\mathrm {susp}}$ and controls at earliest prescription $T_{\mathrm {Rx,start}}$. Sepsis cases and controls were restricted using different clinical-process anchors; differences from canonical discrimination reflect both evaluated observations and outcome-specific selection, and do not represent a uniform prospective eligibility policy}{table.caption.3}{}}
