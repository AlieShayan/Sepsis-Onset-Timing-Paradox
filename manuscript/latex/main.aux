\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Operational Clocks and Anchor-Dependent Evaluation Eligibility in the MIMIC-III MetaVision Cohort.} Panel A: Clinical timeline and evaluation risk sets, designated by milestone markers: \textbf  {a}, ICU admission reference origin ($t = 0\mathrm  {h}, T_{\mathrm  {admit}}$); \textbf  {b}, protocol surveillance monitoring window (hours 19--30 post-admission, comprising 12 discrete hourly decision bins); \textbf  {c}, operationally assigned consensus Sepsis-3 onset ($T_{\mathrm  {S3}} = 28.0\mathrm  {h}$; full cohort median 49.0h, surveillance-covered median 28.0h); \textbf  {d}, clinical suspicion anchor ($T_{\mathrm  {susp}} = 52.0\mathrm  {h}$, defined per Seymour et al.~\cite  {seymour2016assessment} as $\min (T_{\mathrm  {abx,pair}}, T_{\mathrm  {culture,pair}})$); \textbf  {e}, retrospective search-window lead gap ($G_i = T_{\mathrm  {susp}} - T_{\mathrm  {S3}} = 24\mathrm  {h} + h\,\operatorname  {frac}(x_i) < 25\mathrm  {h}$), where retrospective lookback flooring structurally guarantees pre-suspicion eligibility in 67.2\% of incident stays; \textbf  {f}, 6-hour prediction anticipation horizon ($t \in [22\mathrm  {h}, 28\mathrm  {h})$, evaluating binary target $Y_i(t; 6\mathrm  {h}) = \mathbf  {1}\{t < T_{\mathrm  {S3}, i} \le t + 6\mathrm  {h}\}$); \textbf  {g}, pre-suspicion anchor-eligible decision window ($t + \delta \le C_i$; 150 of 151 covered stays, 99.3\%, are eligible under $C_i = T_{\mathrm  {susp}}$); \textbf  {h}, post-anchor period ($t > C_i$), representing care processes already initiated and censored from prospective early-warning evaluation. Panel B: Population opportunity attrition comparing Broad Historical MIMIC-III (earliest prescription proxy $T_{\mathrm  {Rx,start}}$, $N=3,581$) and MIMIC-III MetaVision ($T_{\mathrm  {susp}}$, $N=408$), reporting exact stay counts beside each opportunity tier under declared midnight assignment. \textit  {Alt-text:} Two-panel diagram displaying schematic timeline clocks designated by callout letters a through h in Panel A, and horizontal bar charts comparing treatment-precedence opportunity across anchors in Panel B.}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:clocks}{{1}{4}{\textbf {Operational Clocks and Anchor-Dependent Evaluation Eligibility in the MIMIC-III MetaVision Cohort.} Panel A: Clinical timeline and evaluation risk sets, designated by milestone markers: \textbf {a}, ICU admission reference origin ($t = 0\mathrm {h}, T_{\mathrm {admit}}$); \textbf {b}, protocol surveillance monitoring window (hours 19--30 post-admission, comprising 12 discrete hourly decision bins); \textbf {c}, operationally assigned consensus Sepsis-3 onset ($T_{\mathrm {S3}} = 28.0\mathrm {h}$; full cohort median 49.0h, surveillance-covered median 28.0h); \textbf {d}, clinical suspicion anchor ($T_{\mathrm {susp}} = 52.0\mathrm {h}$, defined per Seymour et al.~\cite {seymour2016assessment} as $\min (T_{\mathrm {abx,pair}}, T_{\mathrm {culture,pair}})$); \textbf {e}, retrospective search-window lead gap ($G_i = T_{\mathrm {susp}} - T_{\mathrm {S3}} = 24\mathrm {h} + h\,\operatorname {frac}(x_i) < 25\mathrm {h}$), where retrospective lookback flooring structurally guarantees pre-suspicion eligibility in 67.2\% of incident stays; \textbf {f}, 6-hour prediction anticipation horizon ($t \in [22\mathrm {h}, 28\mathrm {h})$, evaluating binary target $Y_i(t; 6\mathrm {h}) = \mathbf {1}\{t < T_{\mathrm {S3}, i} \le t + 6\mathrm {h}\}$); \textbf {g}, pre-suspicion anchor-eligible decision window ($t + \delta \le C_i$; 150 of 151 covered stays, 99.3\%, are eligible under $C_i = T_{\mathrm {susp}}$); \textbf {h}, post-anchor period ($t > C_i$), representing care processes already initiated and censored from prospective early-warning evaluation. Panel B: Population opportunity attrition comparing Broad Historical MIMIC-III (earliest prescription proxy $T_{\mathrm {Rx,start}}$, $N=3,581$) and MIMIC-III MetaVision ($T_{\mathrm {susp}}$, $N=408$), reporting exact stay counts beside each opportunity tier under declared midnight assignment. \textit {Alt-text:} Two-panel diagram displaying schematic timeline clocks designated by callout letters a through h in Panel A, and horizontal bar charts comparing treatment-precedence opportunity across anchors in Panel B}{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Cohort Progression and Denominator Accounting Ledger.} Denominators traced from the base test cohort through surveillance eligibility, sepsis onset timing, prediction horizons, and pre-treatment actionability. \textit  {Note:} Rows 1--3b report cohort shares; rows 4--6 report window-level positive prevalence ($\pi $). Historical cohort ($N=3,581$) comprises CareVue-only (1,687), MetaVision-only (1,886), and 8 transitional stays ($1,687 + 1,886 + 8 = 3,581$).}}{4}{table.caption.2}\protected@file@percent }
\newlabel{tab:table1}{{1}{4}{\textbf {Cohort Progression and Denominator Accounting Ledger.} Denominators traced from the base test cohort through surveillance eligibility, sepsis onset timing, prediction horizons, and pre-treatment actionability. \textit {Note:} Rows 1--3b report cohort shares; rows 4--6 report window-level positive prevalence ($\pi $). Historical cohort ($N=3,581$) comprises CareVue-only (1,687), MetaVision-only (1,886), and 8 transitional stays ($1,687 + 1,886 + 8 = 3,581$)}{table.caption.2}{}}
