\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Operational Clocks, Pretreatment Decision Windows, and Population Opportunity Attrition.} Panel A illustrates the clinical timeline for an ICU-incident sepsis patient, showing the diagnostic lead gap $G = T_{\text  {S3}} - T_{\text  {treatment}} = +24.2\text  {h}$ (median), the actionable decision window $\mathcal  {A}_i$, and the post-treatment observation period. Panel B displays population opportunity attrition comparing broad historical MIMIC-III (with calendar-day interval-censored prescription bounds) and MetaVision prospective-replay (hourly confirmed bedside administration records). \textit  {Alt-text:} Two-panel diagram displaying timeline clocks (ICU admission, surveillance start, antimicrobials, Sepsis-3 onset) with mathematical risk-set definitions in Panel A, and horizontal bar charts comparing surveillance coverage and treatment-precedence opportunity between broad historical MIMIC-III and MetaVision cohorts in Panel B.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:clocks}{{1}{3}{\textbf {Operational Clocks, Pretreatment Decision Windows, and Population Opportunity Attrition.} Panel A illustrates the clinical timeline for an ICU-incident sepsis patient, showing the diagnostic lead gap $G = T_{\text {S3}} - T_{\text {treatment}} = +24.2\text {h}$ (median), the actionable decision window $\mathcal {A}_i$, and the post-treatment observation period. Panel B displays population opportunity attrition comparing broad historical MIMIC-III (with calendar-day interval-censored prescription bounds) and MetaVision prospective-replay (hourly confirmed bedside administration records). \textit {Alt-text:} Two-panel diagram displaying timeline clocks (ICU admission, surveillance start, antimicrobials, Sepsis-3 onset) with mathematical risk-set definitions in Panel A, and horizontal bar charts comparing surveillance coverage and treatment-precedence opportunity between broad historical MIMIC-III and MetaVision cohorts in Panel B}{figure.caption.1}{}}
