\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Two-Axis Subgroup and Timestamp Uncertainty Matrix.} Opportunity bounds conditional on fixed operational Sepsis-3 timestamps and surveillance coverage. \textit  {Note:} Subgroup Bounds denote $[O^{\mathrm  {def}}, O^{\mathrm  {poss}}] / \text  {Total}(N)$ within each onset stratum. For All Incident Sepsis-3, within-covered bounds ($[O^{\mathrm  {def}}, O^{\mathrm  {poss}}] / \text  {Covered}[V=1]$) are $[150, 151]/151 = [99.3\%, 100.0\%]$ for MetaVision $T_{\mathrm  {susp}}$, $[0, 47]/151 = [0.0\%, 31.1\%]$ for MetaVision Earliest Rx, and $[1, 111]/337 = [0.30\%, 32.94\%]$ for Broad Historical MIMIC-III.}}{7}{table.caption.6}\protected@file@percent }
\newlabel{tab:table4}{{4}{7}{\textbf {Two-Axis Subgroup and Timestamp Uncertainty Matrix.} Opportunity bounds conditional on fixed operational Sepsis-3 timestamps and surveillance coverage. \textit {Note:} Subgroup Bounds denote $[O^{\mathrm {def}}, O^{\mathrm {poss}}] / \text {Total}(N)$ within each onset stratum. For All Incident Sepsis-3, within-covered bounds ($[O^{\mathrm {def}}, O^{\mathrm {poss}}] / \text {Covered}[V=1]$) are $[150, 151]/151 = [99.3\%, 100.0\%]$ for MetaVision $T_{\mathrm {susp}}$, $[0, 47]/151 = [0.0\%, 31.1\%]$ for MetaVision Earliest Rx, and $[1, 111]/337 = [0.30\%, 32.94\%]$ for Broad Historical MIMIC-III}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Cumulative Population Coverage and Alert Detection Cascade.} Stepwise patient attrition across the evaluation cascade: from 408 incident sepsis stays ($100.0\%$), to surveillance protocol coverage ($N=151$, $37.0\%$, with $63.0\%$ onset $>36\mathrm  {h}$), retrospective suspicion-anchor eligibility ($N=150$, $36.8\%$, governed by lookback flooring), and timely detection under an operational budget of 10 episodes/100 patient-days ($N=7$, $1.72\%$). \textit  {Alt-text:} Four-stage bar chart showing patient opportunity attrition from total incident sepsis (408 patients) to surveillance coverage (151 patients, 37.0\%), suspicion-anchor eligibility (150 patients, 36.8\%), and timely model-alert policy detection (7 patients, 1.72\%).}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:decomp}{{3}{7}{\textbf {Cumulative Population Coverage and Alert Detection Cascade.} Stepwise patient attrition across the evaluation cascade: from 408 incident sepsis stays ($100.0\%$), to surveillance protocol coverage ($N=151$, $37.0\%$, with $63.0\%$ onset $>36\mathrm {h}$), retrospective suspicion-anchor eligibility ($N=150$, $36.8\%$, governed by lookback flooring), and timely detection under an operational budget of 10 episodes/100 patient-days ($N=7$, $1.72\%$). \textit {Alt-text:} Four-stage bar chart showing patient opportunity attrition from total incident sepsis (408 patients) to surveillance coverage (151 patients, 37.0\%), suspicion-anchor eligibility (150 patients, 36.8\%), and timely model-alert policy detection (7 patients, 1.72\%)}{figure.caption.7}{}}
