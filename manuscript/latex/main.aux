\citation{dutta2026performance}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Operational Clocks and Anchor-Dependent Evaluation Eligibility in the MIMIC-III MetaVision Cohort.} The timeline is schematic; displayed population summaries do not represent a single paired patient trajectory. Eligibility relative to a retrospective suspicion anchor does not establish absence of prior antimicrobial exposure. Panel A depicts the clinical timeline for an ICU-incident sepsis stay, illustrating the discrete search-window lead $G_i = 24\text  {h} + h\,\operatorname  {frac}(x_i) < 25\text  {h}$ for first-bin-assigned episodes ($N=274/408$, 67.2\%; median $+24.2\text  {h}$; empirical max $24.99\text  {h}$), the anticipation horizon $t \in [22\mathrm  {h}, 28\mathrm  {h})$, anchor-eligible decision times $\mathcal  {A}_i^{(C)}(\delta )$, and the conceptual post-anchor period. Actual model evaluations occur at discrete scored timestamps $t \in \mathcal  {T}_i$. Panel B displays population opportunity attrition comparing Broad Historical MIMIC-III (earliest prescription proxy $T_{\mathrm  {Rx,start}}$, $N=3,581$) and MIMIC-III MetaVision (suspicion anchor $T_{\mathrm  {susp}}$, $N=408$), reporting exact stay counts beside each opportunity tier under declared midnight assignment; this comparison reflects concurrent differences in both cohort selection and anchor definition rather than isolating an anchor effect alone. \textit  {Alt-text:} Two-panel diagram displaying schematic timeline clocks and formal risk-set definitions in Panel A, and horizontal bar charts comparing surveillance coverage and treatment-precedence opportunity in Panel B.}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:clocks}{{1}{4}{\textbf {Operational Clocks and Anchor-Dependent Evaluation Eligibility in the MIMIC-III MetaVision Cohort.} The timeline is schematic; displayed population summaries do not represent a single paired patient trajectory. Eligibility relative to a retrospective suspicion anchor does not establish absence of prior antimicrobial exposure. Panel A depicts the clinical timeline for an ICU-incident sepsis stay, illustrating the discrete search-window lead $G_i = 24\text {h} + h\,\operatorname {frac}(x_i) < 25\text {h}$ for first-bin-assigned episodes ($N=274/408$, 67.2\%; median $+24.2\text {h}$; empirical max $24.99\text {h}$), the anticipation horizon $t \in [22\mathrm {h}, 28\mathrm {h})$, anchor-eligible decision times $\mathcal {A}_i^{(C)}(\delta )$, and the conceptual post-anchor period. Actual model evaluations occur at discrete scored timestamps $t \in \mathcal {T}_i$. Panel B displays population opportunity attrition comparing Broad Historical MIMIC-III (earliest prescription proxy $T_{\mathrm {Rx,start}}$, $N=3,581$) and MIMIC-III MetaVision (suspicion anchor $T_{\mathrm {susp}}$, $N=408$), reporting exact stay counts beside each opportunity tier under declared midnight assignment; this comparison reflects concurrent differences in both cohort selection and anchor definition rather than isolating an anchor effect alone. \textit {Alt-text:} Two-panel diagram displaying schematic timeline clocks and formal risk-set definitions in Panel A, and horizontal bar charts comparing surveillance coverage and treatment-precedence opportunity in Panel B}{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Cohort Progression and Denominator Accounting Ledger.} Denominators traced from the base test cohort through surveillance eligibility, sepsis onset timing, prediction horizons, and pre-treatment actionability. \textit  {Note:} Rows 1--3b report cohort shares; rows 4--6 report window-level positive prevalence ($\pi $). Historical cohort ($N=3,581$) comprises CareVue-only (1,687), MetaVision-only (1,886), and 8 transitional stays ($1,687 + 1,886 + 8 = 3,581$).}}{4}{table.caption.2}\protected@file@percent }
\newlabel{tab:table1}{{1}{4}{\textbf {Cohort Progression and Denominator Accounting Ledger.} Denominators traced from the base test cohort through surveillance eligibility, sepsis onset timing, prediction horizons, and pre-treatment actionability. \textit {Note:} Rows 1--3b report cohort shares; rows 4--6 report window-level positive prevalence ($\pi $). Historical cohort ($N=3,581$) comprises CareVue-only (1,687), MetaVision-only (1,886), and 8 transitional stays ($1,687 + 1,886 + 8 = 3,581$)}{table.caption.2}{}}
